# ===================================================
# Sri Sankara TV E-Commerce Platform - Environment Configuration
# ===================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api/v1

# MongoDB Connection
# Example: mongodb://localhost:27017/sri_sankara_pooja_box
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/sri_sankara_pooja_box?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/sri_sankara_pooja_box

# Razorpay Payment Gateway Credentials (Test or Live)
# Get credentials from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Brevo (formerly Sendinblue) Transactional Email API
# Get credentials from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=orders@srisankaratv.com
BREVO_SENDER_NAME=Sri Sankara TV
BREVO_ORDER_NOTIFICATION_EMAIL=admin@srisankaratv.com

# Admin Authentication & Session
# Generate a cryptographically strong 32+ character string
ADMIN_JWT_SECRET=super_secret_jwt_key_sri_sankara_tv_2026_dev_mode
ADMIN_SESSION_SECRET=session_secret_cookie_sri_sankara_dev_2026
ADMIN_JWT_EXPIRES_IN=7d

# Initial Super Admin Seed Credentials (used only during database seeding)
INITIAL_ADMIN_EMAIL=admin@srisankaratv.com
INITIAL_ADMIN_PASSWORD=SankaraAdmin2026!
INITIAL_ADMIN_NAME=Super Admin
